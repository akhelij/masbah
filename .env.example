# Supabase — get these from the project's API settings
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key

# Public site URL (SEO canonical / sitemap / OG). Set to the prod domain in Vercel.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry DSN (optional — error monitoring; the app no-ops when empty)
NUXT_PUBLIC_SENTRY_DSN=

# Google OAuth is configured in the Supabase dashboard (Auth > Providers),
# not via app env. No client secret lives in this repo.

# Feature flags
NUXT_PUBLIC_PHONE_VERIFICATION_ENABLED=false

# Google Analytics 4 (optional — tracking only; the app no-ops when empty)
NUXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Search Console verification (optional — meta tag verification)
NUXT_PUBLIC_GSC_VERIFICATION=
